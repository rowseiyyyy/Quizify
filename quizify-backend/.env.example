# Copy this file to .env and fill in real values before deploying.

# --- Database ---------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./quizify.db
# MySQL (production):
# DATABASE_URL=mysql+pymysql://quizify_user:password@localhost:3306/quizify
# PostgreSQL (e.g. Railway Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Auth --------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI ------------------------------------------------------------------------
# Leave GEMINI_API_KEY empty to use the built-in offline fallback generator.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=30

# --- CORS ----------------------------------------------------------------------
CORS_ORIGINS=*
