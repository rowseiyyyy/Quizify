# Copy this file to .env and fill in real values before deploying.

# --- Database ---------------------------------------------------------------
# SQLite (default, zero setup):
# DATABASE_URL=sqlite:///./quizify.db
# MySQL (production):
DATABASE_URL=mysql+pymysql://quizify_user:password@localhost:3306/quizify

# --- Auth --------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI ------------------------------------------------------------------------
# Leave OPENAI_API_KEY empty to use the built-in offline fallback generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=30

# --- CORS ----------------------------------------------------------------------
CORS_ORIGINS=*
